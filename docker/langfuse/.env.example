# Copy to docker/langfuse/.env and fill in. docker/langfuse/.env is gitignored.
#
# Every value below ships with a working default in compose.yaml. Those defaults
# are published in the Langfuse docs, so they are public knowledge -- this file
# exists to override the ones that are actually secret. Generate real values:
#
#   openssl rand -hex 32     # ENCRYPTION_KEY (must be exactly 64 hex chars)
#   openssl rand -base64 32  # SALT, NEXTAUTH_SECRET, and the passwords

# --- Core secrets -----------------------------------------------------------
SALT=
# Encrypts API keys and LLM credentials at rest. Changing it later makes every
# stored key undecryptable, so set it once, before first boot.
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# --- Datastores -------------------------------------------------------------
# DATABASE_URL embeds POSTGRES_PASSWORD. Change one and you must change the
# other, or the web and worker containers crash-loop against their own database.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/postgres

CLICKHOUSE_PASSWORD=
REDIS_AUTH=

# --- Object storage (MinIO) -------------------------------------------------
# The three S3 secrets are one MinIO credential read by three subsystems. They
# must all equal MINIO_ROOT_PASSWORD.
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=

# --- Headless bootstrap -----------------------------------------------------
# Creates the org, project and first user on first boot, so nobody has to click
# through the signup screen. The project keys are what the backend then uses as
# CUBEGEN_LANGFUSE_PUBLIC_KEY / CUBEGEN_LANGFUSE_SECRET_KEY in backend/.env.
LANGFUSE_INIT_ORG_ID=cubegen
LANGFUSE_INIT_ORG_NAME=Cubegen
LANGFUSE_INIT_PROJECT_ID=cubegen
LANGFUSE_INIT_PROJECT_NAME=Cube generation
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-0000000000000000
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-0000000000000000
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=Local
LANGFUSE_INIT_USER_PASSWORD=
