# Copy to docker/.env and fill in. docker/.env is gitignored.
#
# Cube connects to the database being modelled. Use the same read-only role the
# adapter uses -- Cube must never be able to write to a customer database.
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=host.docker.internal
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=
CUBEJS_DB_USER=
CUBEJS_DB_PASS=
CUBEJS_DB_SSL=false

# Any random string in development. Required even in dev mode.
CUBEJS_API_SECRET=dev-secret-change-me
