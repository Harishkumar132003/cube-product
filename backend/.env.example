# Copy to backend/.env and fill in. backend/.env is gitignored.
#
# Every key is CUBEGEN_-prefixed and maps to a field on Settings in
# app/core/config.py, which is the authoritative list. Only the two marked
# required have no usable default.

# --- Required ---------------------------------------------------------------
# The app's own database: saved connections, evidence bundles, generated models.
# Never the database being modelled.
CUBEGEN_APP_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/cubegen
CUBEGEN_OPENAI_API_KEY=
CUBEGEN_OPENAI_MODEL=gpt-4.1-mini

# --- Retrieval --------------------------------------------------------------
# Qdrant is a long-lived local service shared with other projects, so this owns
# one collection rather than writing into theirs. Leave the API key empty for a
# local instance. Retrieval needs OpenAI too, since embedding runs through it.
CUBEGEN_QDRANT_URL=http://localhost:6333
CUBEGEN_QDRANT_API_KEY=
CUBEGEN_QDRANT_COLLECTION=cubegen_view_members
# 1536 dimensions, matching the collections already on this Qdrant.
CUBEGEN_EMBEDDING_MODEL=text-embedding-3-small

# --- Tracing ----------------------------------------------------------------
# Self-hosted from docker/langfuse. Everything works without it: the tracing
# layer becomes a no-op when the keys are absent. Set CUBEGEN_TRACING=false to
# stop tracing without clearing the credentials -- "configured" and "wanted" are
# different things, and blanking keys to silence it loses them.
CUBEGEN_TRACING=true
# These two are LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY from
# docker/langfuse/.env, or a project API key pair from the Langfuse UI.
CUBEGEN_LANGFUSE_PUBLIC_KEY=
CUBEGEN_LANGFUSE_SECRET_KEY=
CUBEGEN_LANGFUSE_BASE_URL=http://localhost:3000

# --- Cube -------------------------------------------------------------------
# Standalone Cube from docker/compose.yaml. The SQL settings address Cube's
# Postgres-wire API, which the agent queries through -- they are Cube's own
# credentials, not the modelled database's.
CUBEGEN_CUBE_API_URL=http://localhost:4000
CUBEGEN_CUBE_SQL_HOST=127.0.0.1
CUBEGEN_CUBE_SQL_PORT=15432
CUBEGEN_CUBE_SQL_USER=cube
CUBEGEN_CUBE_SQL_PASSWORD=cube
CUBEGEN_CUBE_SQL_DATABASE=cube

# --- Frontend ---------------------------------------------------------------
# The dev frontend. Tighten for any real deployment.
CUBEGEN_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
